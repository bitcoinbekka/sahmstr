# SAHMstr AI proxy config. Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env && nano .env && chmod 600 .env

# The vision provider's OpenAI-compatible base URL.
OPENAI_BASE_URL=https://api.x.ai/v1

# Your provider API key (SECRET — lives only here on the VPS).
OPENAI_API_KEY=xai-REPLACE-ME

# A vision-capable model id from your provider.
VISION_MODEL=grok-2-vision-1212

# Internal port to listen on (must be free — check `sudo ss -tlnp`).
PORT=8090

# Leave blank when Caddy/nginx serve app + proxy on the same origin (the normal
# case). Only set this to your site origin if you call the proxy cross-origin.
ALLOW_ORIGIN=
