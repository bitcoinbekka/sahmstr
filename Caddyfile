# Caddyfile for SAHMstr
# =====================
#
# A single-page React app served as static files, with automatic HTTPS.
# This mirrors the intent of public/_headers and public/_redirects (which
# Caddy does NOT read) so behaviour matches Netlify/Vercel deploys.
#
# Assumptions:
#   - Built site (`npm run build` output, i.e. the `dist/` folder) is served
#     from /srv inside the container / on the host. Adjust `root` if different.
#   - `sahmster.com` redirects to `sahmstr.com`.
#
# Two blank lines separate independent site blocks.


# --- Redirect the alternate domain to the canonical one -------------------
# Preserves the path and query string, permanent (301).
sahmster.com, www.sahmster.com, www.sahmstr.com {
	redir https://sahmstr.com{uri} permanent
}


# --- The canonical site ---------------------------------------------------
sahmstr.com {
	# Where the built files live. This is the `dist/` folder from the Vite
	# build. If you bind-mount elsewhere, change this one line.
	root * /srv

	# Compress responses. Caddy negotiates the best available encoding.
	encode zstd gzip

	# --- Caching policy ---------------------------------------------------
	# The HTML shell must NEVER be cached, or visitors keep loading an old
	# shell that points at deleted, content-hashed bundles — the classic
	# blank-page-after-deploy. The manifest is treated the same way.
	@html {
		path /index.html /404.html /manifest.webmanifest
	}
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Content-hashed JS/CSS can be cached forever: a new build produces a
	# new filename. Covers both build layouts:
	#   - Vite (local):        /assets/index-XXXX.js, /assets/index-XXXX.css
	#   - Shakespeare (browser): /main-XXXX.js, /shakespeare_tailwind.config-XXXX.js
	@immutable {
		path /assets/* /main-*.js /main-*.css /shakespeare_tailwind.config-*.js
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# --- Security headers -------------------------------------------------
	# The Content-Security-Policy is declared in index.html's <meta> tag and
	# is served with the document, so it is not duplicated here. These are
	# the transport-level headers that a meta tag cannot set.
	header {
		# Sent on HTTPS; tells browsers to stay on HTTPS for a year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Stop MIME sniffing.
		X-Content-Type-Options "nosniff"
		# Referrer hygiene.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Don't advertise the server software.
		-Server
	}

	# --- SPA fallback -----------------------------------------------------
	# Serve the requested file if it exists; otherwise fall back to the
	# React shell so client-side routes (/recipes, /tips/food, /npub1...)
	# resolve. This is the Caddy equivalent of the _redirects `/* -> /index.html`
	# rule. `try_files` with a final /index.html does exactly that.
	try_files {path} /index.html
	file_server
}
