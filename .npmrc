# Nostrify (@nostrify/*) comes from the Deno ecosystem and depends on JSR
# packages published under the `@jsr` scope (e.g. @jsr/std__encoding). npm does
# not know where to fetch `@jsr/*` from by default and 404s against the public
# npm registry. Point that scope at the JSR registry so a real `npm install`
# resolves them. Without this, the production build cannot install dependencies.
@jsr:registry=https://npm.jsr.io
